# Copy this file to ".env" and adjust the values.
# Kopiere diese Datei nach ".env" und passe die Werte an.

# Password for the web interface (please change!)
APP_PASSWORD=change-me

# Time zone for schedules, day/night and history
TZ=Europe/Berlin

# Port of the web interface (UGOS itself uses 9443 and 9999)
GROWDECK_PORT=8080

# Data folder (SQLite database, backups, photos). Relative to this folder or absolute,
# e.g. /volume1/docker/growdeck/data
GROWDECK_DATA=./data

# Default language of notifications (Telegram, web address): de or en.
# Can also be changed in the app under Settings → Notifications.
GD_LANGUAGE=de

# Vivosun account. May stay empty and be entered later in the app
# (Settings → Connections).
VIVOSUN_EMAIL=
VIVOSUN_PASSWORD=

# AC Infinity account (Wi-Fi controllers). May also stay empty.
ACINFINITY_EMAIL=
ACINFINITY_PASSWORD=

# Optional: Telegram bot for notifications (usually set up in the app instead).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Demo with simulated devices of all three brands (true/false)
DEMO_MODE=false

# Spider Farmer via the local proxy (true/false)
SPIDERFARMER_ENABLED=true

# Store readings every ... seconds, and keep them for ... days
HISTORY_INTERVAL_SECONDS=60
RETENTION_DAYS=90

# Optional DNS service that redirects sf.mqtt.spider-farmer.com to the NAS.
# To enable it, uncomment the next line and set NAS_IP.
# COMPOSE_PROFILES=dns
NAS_IP=192.168.178.20
